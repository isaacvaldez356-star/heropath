# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543)
# Sin DATABASE_URL se usa PGlite local guardado en data/
DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Clave para firmar los tokens. Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

PORT=3001
